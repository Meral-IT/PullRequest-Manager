{
  "name": "meralit-pullrequestmanager",
  "version": "0.0.1-alpha.1",
  "description": "PullRequest-Manager",
  "main": "./out/main/main.js",
  "license": "PullRequestManager License",
  "homepage": "https://github.com/Meral-IT/PullRequest-Manager#readme",
  "bugs": {
    "url": "https://github.com/Meral-IT/PullRequest-Manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Meral-IT/PullRequest-Manager.git"
  },
  "author": {
    "name": "Necati Meral",
    "email": "hallo@meral.cloud",
    "url": "https://meral.cloud"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev -w",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --fix",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-redux": "^2.0.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@fluentui/react-components": "^9.68.2",
    "@fluentui/react-icons": "^2.0.309",
    "@reduxjs/toolkit": "^2.8.2",
    "@rushstack/eslint-patch": "^1.10.5",
    "@types/node": "^22.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "azure-devops-node-api": "^14.1.0",
    "dompurify": "^3.2.6",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "framer-motion": "^12.23.12",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.6.3",
    "sass-embedded": "^1.91.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
